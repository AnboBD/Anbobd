{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/inject-supabase-config.mjs",
  "cleanUrls": true,
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "redirects": [
    {
      "destination": "/?auth=signin",
      "permanent": false,
      "source": "/login"
    },
    {
      "destination": "/?auth=signup",
      "permanent": false,
      "source": "/register"
    },
    {
      "destination": "/?auth=signup",
      "permanent": false,
      "source": "/signup"
    }
  ],
  "rewrites": [
    {
      "destination": "/admin/index.html",
      "source": "/admin"
    },
    {
      "destination": "/admin/index.html",
      "source": "/admin/"
    },
    {
      "destination": "/seller/index.html",
      "source": "/seller"
    },
    {
      "destination": "/seller/index.html",
      "source": "/seller/"
    },
    {
      "destination": "/pages/return-refund.html",
      "source": "/return-refund"
    },
    {
      "destination": "/pages/delivery.html",
      "source": "/delivery"
    },
    {
      "destination": "/pages/warranty.html",
      "source": "/warranty"
    },
    {
      "destination": "/pages/privacy.html",
      "source": "/privacy"
    },
    {
      "destination": "/pages/contact.html",
      "source": "/contact"
    },
    {
      "destination": "/pages/about.html",
      "source": "/about"
    },
    {
      "destination": "/pages/terms.html",
      "source": "/terms"
    },
    {
      "destination": "/pages/career.html",
      "source": "/career"
    },
    {
      "destination": "/api/og",
      "source": "/product"
    }
  ]
}
